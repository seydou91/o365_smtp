<?php

/**
 * @file
 * Install, update and uninstall functions for the Office 365 SMTP module.
 */

use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
use Drupal\o365_smtp\Hook\O365SmtpRequirements;
use Drupal\o365_smtp\Service\O365Client;

/**
 * Implements hook_requirements().
 *
 * Only used before Drupal 11.3, which calls
 * O365SmtpRequirements::runtime() instead.
 */
#[LegacyRequirementsHook]
function o365_smtp_requirements($phase) {
  if ($phase !== 'runtime') {
    return [];
  }
  return \Drupal::service('class_resolver')
    ->getInstanceFromDefinition(O365SmtpRequirements::class)
    ->runtime();
}

/**
 * Implements hook_uninstall().
 */
function o365_smtp_uninstall() {
  \Drupal::state()->deleteMultiple([
    ...O365Client::TOKEN_STATE_KEYS,
    O365Client::REAUTHORIZATION_REQUIRED,
  ]);
}

/**
 * Add the default values of the new settings to the existing configuration.
 */
function o365_smtp_update_10101() {
  $config = \Drupal::configFactory()->getEditable('o365_smtp.settings');
  $defaults = [
    'client_id' => '',
    'client_secret' => '',
    'tenant_id' => '',
    'from_email' => '',
    'from_name' => '',
    'helo_hostname' => '',
    'max_attachment_size' => O365Client::DEFAULT_MAX_ATTACHMENT_SIZE,
  ];
  foreach ($defaults as $key => $default) {
    if ($config->get($key) === NULL) {
      $config->set($key, $default);
    }
  }
  $config->save();
  return t('Added the EHLO host name and maximum attachment size settings. Update the redirect URI of the Microsoft Entra ID application to /admin/config/system/o365_smtp/oauth/callback before authorizing again.');
}
